# Allow the deployed frontend to call the API (comma-separated)
NEXORA_CORS_ORIGINS=https://your-nexora.vercel.app
# Shared key ESP32 nodes send in X-Device-Key (change for production)
NEXORA_DEVICE_KEY=nexora-dev-key
# Demo account password (resident@ / operator@ / manager@nexora.demo)
NEXORA_DEMO_PASSWORD=nexora123
# Where the SQLite file lives (point at a persistent disk on Render)
NEXORA_DB=/var/data/nexora.db
NEXORA_UPLOADS=/var/data/uploads
# Optional: Telegram alerts — create a bot with @BotFather, add it to a group, put the group id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-zone groups
TELEGRAM_CHAT_ZONE_A=
TELEGRAM_CHAT_ZONE_B=
TELEGRAM_CHAT_ZONE_C=
# Engineering assumptions (see backend/township/config.py)
NEXORA_WATER_TARIFF=2.00
NEXORA_LPCD=220
